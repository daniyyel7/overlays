        <estrofas>
            <estrofa numero="1">
                <linea>Si por causa de tu fe te han abandonado,</linea>
                <linea>Si por ser leal a Él,de ti se han burlado,</linea>
                <linea>recuerda las historias del ayer,</linea>
                <linea>no olvides que tu Dios ha sido fiel.</linea>
            </estrofa>
            <estrofa numero="2">
                <linea>Si has pensado en renunciar, por favor detente,</linea>
                <linea>sigue firme hasta el final, sé en verdad valiente,</linea>
                <linea>recuerda a los leones y Daniel,</linea>
                <linea>recuerda aquella a cárcel y José.</linea>
            </estrofa>
            <estrofa numero="3">
                <linea>Confía, Dios no te olvida,</linea>
                <linea>tu vida está en sus manos,</linea>
                <linea>en primavera, otoño, invierno y verano.</linea>
                <linea>Confía, Dios no te olvida,</linea>
                <linea>sigue por fe luchando,</linea>
                <linea>sigue por fe cantando,</linea>
                <linea>sigue hoy proclamando que Dios, muy pronto volverá</linea>
